{
  "name": "dsh-funa-bridge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "dsh 端桥接插件：借用 Funa(AstrBot) 的账号给 qzy 发消息，并轮询 cache/inbox 里的指令、把结果写回 outbox。",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "license": "MIT"
}
