{
  "name": "dsh-astrbot-gateway",
  "version": "0.6.1",
  "type": "module",
  "description": "DSH cordis plugin: task dispatch, session wake-up and completion reporting through the AstrBot dsh gateway.",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "astrbot",
    "bridge",
    "notification"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qzy033/dsh-astrbot-gateway.git",
    "directory": "plugin/dsh-astrbot-gateway"
  },
  "homepage": "https://github.com/qzy033/dsh-astrbot-gateway#readme",
  "bugs": {
    "url": "https://github.com/qzy033/dsh-astrbot-gateway/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
